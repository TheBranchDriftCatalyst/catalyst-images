# Nix build outputs
nix/result
nix/result-*

# Environment files (may contain secrets)
.env
.env.*

# Claude Code settings (machine-specific)
.claude/

# OS files
.DS_Store
*.swp
*.swo
*~

# Editor directories
.idea/
.vscode/
*.code-workspace

# Tilt
.tilt-settings.json

# Temporary files
*.tmp
*.log

# Python — this repo was nix/docker only until gpu/shim arrived, so it had no
# Python rules at all and __pycache__/ showed up as untracked noise on the
# first test run.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# uv/venv for the shim's local dev
gpu/shim/.venv/
