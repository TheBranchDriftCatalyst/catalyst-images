{
  "_meta": {
    "name": "chroma-radiance",
    "friendly_name": "Chroma1 Radiance",
    "description": "Chroma1-Radiance x0 \u2014 pixel-space Flux-arch fine-tune, distillation stripped, 30-step euler with beta scheduling at 1024x1024",
    "excels_at": "Uncensored general-purpose generation with no VAE round-trip (pixel-space decode); successor to chroma-hd",
    "default_size": "1024x1024",
    "max_size": "1536x1536",
    "supports_negative": true,
    "approx_seconds_m5_max": 274,
    "tags": [
      "flux-arch",
      "chroma",
      "radiance",
      "uncensored"
    ],
    "parameters": {
      "prompt": "$nodes.5.inputs.text",
      "negative_prompt": "$nodes.6.inputs.text",
      "width": "$nodes.7.inputs.width",
      "height": "$nodes.7.inputs.height",
      "seed": "$nodes.9.inputs.noise_seed"
    },
    "lora_injection": {
      "model": {
        "source": "1",
        "output": 0,
        "consumers": [
          "4"
        ]
      },
      "clip": {
        "source": "2",
        "output": 0,
        "consumers": [
          "5",
          "6"
        ]
      }
    }
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "chroma-radiance-x0.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
