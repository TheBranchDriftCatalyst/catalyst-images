    "inputs": {
      "noise": [
        "9",
        0
      ],
      "guider": [
        "10",
        0
      ],
      "sampler": [
        "12",
        0
      ],
      "sigmas": [
        "8",
        0
      ],
      "latent_image": [
        "7",
        0
      ]
    }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "13",
        0
      ],
      "vae": [
        "3",
        0
      ]
