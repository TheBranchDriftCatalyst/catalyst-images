{
  "_meta": {
    "name": "sdxl-illustrious-xl",
    "description": "Illustrious-XL v2.0 — SDXL anime/illustration fine-tune (OnomaAI Research), 28-step euler ancestral",
    "default_size": "1024x1024",
    "max_size": "1536x1536",
    "supports_negative": true,
    "approx_seconds_m5_max": 16,
    "parameters": {
      "prompt": "$nodes.3.inputs.text",
      "width": "$nodes.2.inputs.width",
      "height": "$nodes.2.inputs.height",
      "seed": "$nodes.5.inputs.seed"
    },
    "lora_injection": {
      "model": { "source": "1", "output": 0, "consumers": ["5"] },
      "clip":  { "source": "1", "output": 1, "consumers": ["3", "4"] }
    }
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "Illustrious-XL-v2.0.safetensors"
    }
  },
  "2": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "REPLACED_AT_RUNTIME"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "worst quality, low quality, blurry, jpeg artifacts, watermark, signature, text"
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["2", 0],
      "seed": 0,
      "steps": 28,
      "cfg": 5.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "shim/sdxl-illustrious"
    }
  }
}
